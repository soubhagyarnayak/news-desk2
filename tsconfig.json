{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2018",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
  },
  "exclude": ["node_modules","./scripts","./dist"],
  "noImpicitAny": true,
  "strictNullChecks": true,
}
