<html lang="en">
<head>
    <%- include ('partials/head') %>
    <title>News Desk</title>
    <style>
        .variation-positive { color: #198754; }
        .variation-negative { color: #dc3545; }
        .stock-refreshing { opacity: 0.5; pointer-events: none; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark">
        <div class="container">
            <span class="navbar-brand">News Desk</span>
        </div>
    </nav>
    <div class="container py-5">
        <main>
            <div class="text-center pb-4 mb-5 border-bottom">
                <h1 class="display-5 fw-bold">News Desk</h1>
                <p class="lead text-muted">You are what you read.</p>
            </div>

            <div class="row g-4 justify-content-center mb-5">
                <div class="col-md-3">
                    <a href="/hn" class="text-decoration-none">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center py-4">
                                <h2 class="card-title h5 fw-semibold mb-2">Hacker News</h2>
                                <p class="card-text text-muted small">Browse and manage your Hacker News article backlog.</p>
                            </div>
                            <div class="card-footer text-center bg-transparent border-top-0 pb-3">
                                <span class="btn btn-outline-dark btn-sm">Open &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/oped" class="text-decoration-none">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center py-4">
                                <h2 class="card-title h5 fw-semibold mb-2">Opinions &amp; Editorials</h2>
                                <p class="card-text text-muted small">Read and annotate curated opinion and editorial pieces.</p>
                            </div>
                            <div class="card-footer text-center bg-transparent border-top-0 pb-3">
                                <span class="btn btn-outline-dark btn-sm">Open &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/rss/entries" class="text-decoration-none">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center py-4">
                                <h2 class="card-title h5 fw-semibold mb-2">RSS Entries</h2>
                                <p class="card-text text-muted small">Browse and manage entries from your RSS feeds.</p>
                            </div>
                            <div class="card-footer text-center bg-transparent border-top-0 pb-3">
                                <span class="btn btn-outline-dark btn-sm">Open &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/settings" class="text-decoration-none">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body text-center py-4">
                                <h2 class="card-title h5 fw-semibold mb-2">Settings</h2>
                                <p class="card-text text-muted small">Refresh, purge, and manage your feed sources.</p>
                            </div>
                            <div class="card-footer text-center bg-transparent border-top-0 pb-3">
                                <span class="btn btn-outline-dark btn-sm">Open &rarr;</span>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">Stocks &amp; Funds</span>
                    <span class="badge bg-secondary"><%=stocks.length%></span>
                </div>
                <% if (stocks.length === 0) { %>
                    <div class="card-body text-center text-muted py-4">
                        <p class="mb-0">No stocks configured.</p>
                        <p class="small mb-0">Add entries to the <code>StockMetadata</code> table to get started.</p>
                    </div>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Symbol</th>
                                    <th>Country</th>
                                    <th class="text-end">Value</th>
                                    <th class="text-end">Variation</th>
                                    <th>Last Update</th>
                                    <th>Last Refreshed</th>
                                    <th></th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <% stocks.forEach(function(stock) { %>
                                    <tr id="stock-<%=stock.id%>">
                                        <td class="fw-semibold"><%=stock.name%></td>
                                        <td><code><%=stock.symbol%></code></td>
                                        <td class="text-muted"><%=stock.country || '-'%></td>
                                        <td class="text-end stock-value">
                                            <%=stock.value != null ? stock.value.toFixed(2) : '-'%>
                                        </td>
                                        <td class="text-end stock-variation <%=stock.variation != null ? (stock.variation >= 0 ? 'variation-positive' : 'variation-negative') : ''%>">
                                            <%=stock.variation != null ? (stock.variation >= 0 ? '+' : '') + stock.variation.toFixed(2) + '%' : '-'%>
                                        </td>
                                        <td class="text-muted small stock-last-update">
                                            <%=stock.lastUpdateTime ? new Date(stock.lastUpdateTime).toLocaleString() : '-'%>
                                        </td>
                                        <td class="text-muted small stock-last-refreshed">
                                            <%=stock.lastRefreshedTime ? new Date(stock.lastRefreshedTime).toLocaleString() : '-'%>
                                        </td>
                                        <td>
                                            <% if (stock.link) { %>
                                                <a href="<%=stock.link%>" target="_blank" class="btn btn-sm btn-outline-secondary">View</a>
                                            <% } %>
                                        </td>
                                        <td>
                                            <button class="refreshStockButton btn btn-sm btn-outline-primary" data-id="<%=stock.id%>">Refresh</button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </div>

        </main>
    </div>
    <script src="/scripts/stocks.js"></script>
</body>
</html>
